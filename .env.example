# Database (PostgreSQL) — required
DATABASE_URL="postgresql://user:password@host:5432/invoice_tracker?schema=public"

# Clerk authentication — required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Cron job security — required for /api/cron/*
CRON_SECRET=

# App URL — required in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Vercel Blob for PDF invoice attachments and organization logos
BLOB_READ_WRITE_TOKEN=

# Optional: AI PDF invoice extraction (Gemini preferred, OpenAI fallback)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Sentry
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
